# Copia este archivo como .env.local y rellénalo. .env.local no se sube al repo.
# Los cuatro primeros salen de Firebase: Configuración del proyecto > Tus apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Dominio que se añade al usuario si no lleva "@". Debe coincidir con el email
# de tu usuario en Firebase Auth. Ejemplo: con "miweb.test", el usuario "ana"
# inicia sesión como ana@miweb.test.
VITE_LOGIN_DOMAIN=

# Solo en desarrollo: usa los emuladores locales en lugar de Firebase.
# VITE_USE_EMULATORS=true
